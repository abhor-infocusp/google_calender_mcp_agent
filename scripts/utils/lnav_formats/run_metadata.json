{
  "$schema": "https://lnav.org/schemas/format-v1.schema.json",
  "_calendar_agent_run_metadata": {
    "title": "calendar-agent run metadata",
    "description": "One line per process start: env, deps, sibling GPU pids, isolation knobs.",
    "json": true,
    "file-pattern": "metadata\\.jsonl$",
    "timestamp-field": "ts",
    "value": {
      "schema_version": {
        "kind": "integer"
      },
      "pid": {
        "kind": "integer",
        "identifier": true
      },
      "host": {
        "kind": "string",
        "identifier": true
      },
      "git_commit": {
        "kind": "string",
        "identifier": true
      },
      "git_dirty": {
        "kind": "string"
      },
      "run_dir": {
        "kind": "string",
        "identifier": true
      },
      "cuda_visible_devices": {
        "kind": "string"
      },
      "taskset_cpus": {
        "kind": "string"
      },
      "omp_num_threads": {
        "kind": "string"
      },
      "art_deadlock_timeout_s": {
        "kind": "string"
      },
      "checkpoint_keep_every": {
        "kind": "string"
      },
      "python_version": {
        "kind": "string"
      }
    }
  }
}