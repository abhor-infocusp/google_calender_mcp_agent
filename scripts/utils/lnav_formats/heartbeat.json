{
  "$schema": "https://lnav.org/schemas/format-v1.schema.json",
  "_calendar_agent_heartbeat": {
    "title": "calendar-agent heartbeat",
    "description": "Phase + step heartbeat written every 30s by rl_train.py / rl_train_small.py",
    "url": "https://github.com/abhor/google_calender_mcp_agent",
    "json": true,
    "file-pattern": "heartbeat\\.jsonl$",
    "timestamp-field": "ts",
    "value": {
      "schema_version": {
        "kind": "integer"
      },
      "phase": {
        "kind": "string",
        "identifier": true
      },
      "step": {
        "kind": "integer"
      },
      "phase_age_s": {
        "kind": "float"
      },
      "pid": {
        "kind": "integer",
        "identifier": true
      }
    }
  }
}